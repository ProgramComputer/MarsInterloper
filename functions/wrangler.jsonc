{
  "name": "marsinterloper",
  "main": "./src/index.js",
  "compatibility_date": "2025-05-24",
  "vars": {
    "ALLOWED_ORIGIN": "https://mars.pchirp.com"
  },
  "routes": [
    "mars.pchirp.com/api/*",
    "mars.pchirp.com/assets/*",
    "mars.pchirp.com/ws"
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS_BUCKET",
      "bucket_name": "mars"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MULTIPLAYER",
        "class_name": "MultiplayerRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MultiplayerRoom"]
    }
  ]
}
