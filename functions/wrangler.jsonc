{
  "name": "marsinterloper",
  "main": "./build/worker.mjs",
  "compatibility_date": "2025-05-24",
  "vars": {
    "ALLOWED_ORIGIN": "https://mars.pchirp.com"
  },
  "routes": [
    "mars.pchirp.com/api/*",
    "mars.pchirp.com/assets/*"
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS_BUCKET",
      "bucket_name": "mars"
    }
  ],
  "build": {
    "command": "npm run build"
  }
}
